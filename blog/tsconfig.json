{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./app/*"],
      "~/*": ["./app/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.vue", "types/**/*.ts", "nuxt.config.ts"],
  "exclude": ["node_modules", ".output", ".nuxt"]
}
